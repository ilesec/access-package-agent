# Environment: dev
# Copy this file to env/.env.dev and fill in your values.

# Azure subscription & resource group
RESOURCE_GROUP=rg-access-package-agent-dev
LOCATION=swedencentral
AZURE_SUBSCRIPTION_ID=<your-subscription-id>

# Entra ID app registration
AZURE_TENANT_ID=<your-tenant-id>
AZURE_CLIENT_ID=<your-app-client-id>
AZURE_CLIENT_SECRET=<your-app-client-secret>

# Bicep base name (used for naming resources)
BASE_NAME=accpkgagent

# Azure Function App name (populated after first deployment, required for -SkipInfra)
AZURE_FUNCTION_APP_NAME=

# Teams app (populated by ATK provision)
TEAMS_APP_ID=

# M365 Copilot app ID (populated by ATK provision)
M365_APP_ID=
